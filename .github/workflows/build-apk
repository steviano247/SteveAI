name: Build SteveAI APK

on:
  push:
    branches: [main]
    paths-ignore: ['apps-script/**', 'README.md']
  workflow_dispatch:

permissions:
  contents: write   # needed to publish the Release

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Read version from package.json
        run: echo "VERSION=$(node -p "require('./package.json').version")" >> "$GITHUB_ENV"

      - name: Sync version into the app (used by "Check for updates")
        run: |
          sed -i "s/APP_VERSION: '[^']*'/APP_VERSION: '${VERSION}'/" www/js/config.js
          grep -n APP_VERSION www/js/config.js

      - name: Install dependencies
        run: npm install --no-audit --no-fund

      - name: Create Android project
        run: npx cap add android

      - name: Generate icon (S) and splash from /assets
        run: npx capacitor-assets generate --android

      - name: Set version code and name
        run: |
          sed -i "s/versionCode 1/versionCode ${{ github.run_number }}/; s/versionName \"1.0\"/versionName \"${VERSION}\"/" android/app/build.gradle
          grep -n "versionCode\|versionName" android/app/build.gradle

      - name: Sync web files into Android
        run: npx cap sync android

      - name: Build release APK (unsigned)
        working-directory: android
        run: ./gradlew assembleRelease --no-daemon

      - name: Align and sign APK
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ]; then
            echo "$KEYSTORE_BASE64" | base64 -d > release.keystore
            KS=release.keystore; PASS="$KEYSTORE_PASSWORD"; ALIAS="${KEY_ALIAS:-steveai}"
            echo "Signing with your private keystore (secrets)."
          else
            KS=signing/steveai.keystore; PASS="steveai-stevexa"; ALIAS="steveai"
            echo "Signing with the bundled default keystore. Add secrets for a private key (see README)."
          fi
          BT=$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -1)
          UNSIGNED=android/app/build/outputs/apk/release/app-release-unsigned.apk
          "$BT/zipalign" -p -f 4 "$UNSIGNED" aligned.apk
          "$BT/apksigner" sign --ks "$KS" --ks-pass "pass:$PASS" --key-pass "pass:$PASS" --ks-key-alias "$ALIAS" --out SteveAI.apk aligned.apk
          "$BT/apksigner" verify SteveAI.apk && echo "APK signature OK"

      - uses: actions/upload-artifact@v4
        with:
          name: SteveAI-apk
          path: SteveAI.apk

      - name: Publish GitHub Release (the app's update checker reads this)
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ env.VERSION }}
          name: SteveAI v${{ env.VERSION }}
          body_path: RELEASE_NOTES.md
          files: SteveAI.apk
